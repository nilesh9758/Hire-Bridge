PORT=3000
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string WITHOUT a database name (the app uses the "hirebridge" database)
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Resume storage (Cloudinary)
# From the Cloudinary console: Settings > API Keys (cloud name is shown at the top)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Any long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=10d
PASSWORD_RESET_TOKEN_SECRET=change-me-as-well
PASSWORD_RESET_TOKEN_EXPIRY=15m

# Admin account (created on first server start; there is no admin sign-up)
ADMIN_NAME=Placement Admin
ADMIN_EMAIL=admin@hirebridge.app
ADMIN_PASSWORD=Admin123

# Email. Leave SMTP_HOST empty to use a free Ethereal test inbox (preview links, no real delivery).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HireBridge <no-reply@hirebridge.app>
TIMEZONE=Asia/Kolkata

# Redis (optional). Enables caching and rate limits shared across server instances.
# Local: redis://127.0.0.1:6379   Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=

# Send emails through a background queue with retries (needs REDIS_URL and a running
# `npm run worker`). Keep false on Vercel, which can't run the worker.
QUEUE_EMAILS=false
EMAIL_WORKER_CONCURRENCY=5
